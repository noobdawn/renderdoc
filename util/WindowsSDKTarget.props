<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" ToolsVersion="12.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

<!-- visual studio doesn't have a way to say "I don't care about the SDK version". Targetting an old version will explicitly fail on new SDKs for some stupid reason. So instead we try to target the latest windows 10 SDK or 8.1 if no windows 10 SDK is installed -->

<!-- Note, in VS2019 this is semi-fixed and you can specify 10.0 to mean 'any windows 10 SDK'. However a) presumably this will break when windows 11 ships. b) it only works if you're using the v142 toolset for no good reason. -->
<PropertyGroup>

	<NoobDawnLatestWin10SDKVersion>$(Registry:HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Microsoft SDKs\Windows\v10.0@ProductVersion)</NoobDawnLatestWin10SDKVersion>

	<!-- VS2022 is 64-bit and apparently the win10 SDK doesn't set up 64-bit registry keys. So to cover that case explicitly check the 32-bit node -->
	<NoobDawnLatestWin10SDKVersion Condition="'$(NoobDawnLatestWin10SDKVersion)'==''">$(Registry:HKEY_LOCAL_MACHINE\SOFTWARE\WOW6432Node\Microsoft\Microsoft SDKs\Windows\v10.0@ProductVersion)</NoobDawnLatestWin10SDKVersion>

	<!-- version needed has extra .0 -->
	<NoobDawnLatestWin10SDKVersion Condition="'$(NoobDawnLatestWin10SDKVersion)'!=''">$(NoobDawnLatestWin10SDKVersion).0</NoobDawnLatestWin10SDKVersion>

	<!-- if we found the SDK version, use it. Otherwise fall back to 8.1. Since we require VS2015 which installed the 8.1 SDK at minimum we don't need to fallback any earlier (though we don't use anything from the 8.1 SDK either) -->
	<WindowsTargetPlatformVersion Condition="'$(NoobDawnLatestWin10SDKVersion)'!=''">$(NoobDawnLatestWin10SDKVersion)</WindowsTargetPlatformVersion>
	<WindowsTargetPlatformVersion Condition="'$(NoobDawnLatestWin10SDKVersion)'==''">8.1</WindowsTargetPlatformVersion>

	<!-- use the native toolset for each VS version -->

	<!-- VS2015 - minimum version -->
	<PlatformToolset Condition="'$(VisualStudioVersion)' == '14.0'">v140</PlatformToolset>
	<!-- VS2017 -->
	<PlatformToolset Condition="'$(VisualStudioVersion)' == '15.0'">v141</PlatformToolset>
	<!-- VS2019 -->
	<PlatformToolset Condition="'$(VisualStudioVersion)' == '16.0'">v142</PlatformToolset>
	<!-- VS2022 -->
	<PlatformToolset Condition="'$(VisualStudioVersion)' == '17.0'">v143</PlatformToolset>
	<!-- VS2022 -->
	<PlatformToolset Condition="'$(VisualStudioVersion)' == '18.0'">v145</PlatformToolset>
	<!-- future VS version? -->
	<PlatformToolset Condition="'$(PlatformToolset)' == ''">v145</PlatformToolset>
</PropertyGroup>

</Project>
