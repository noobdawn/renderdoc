<?xml version='1.0' encoding='windows-1252'?>
<Wix xmlns='http://schemas.microsoft.com/wix/2006/wi'>
  <Product Name='NoobDawn' Id='*' UpgradeCode='D320753C-4B18-4905-A752-E68959943E7D'
    Language='1033' Codepage='1252' Version='$(env.NOOBDAWN_VERSION).0' Manufacturer='Baldur Karlsson'>

    <Package Id='*' Keywords='Installer' Description="Installer for NoobDawn"
      Comments='NoobDawn Homepage is http://noobdawn.org/' Platform="x64" Manufacturer='Baldur Karlsson'
      InstallerVersion='301' Languages='1033' Compressed='yes' SummaryCodepage='1252' />

    <InstallExecuteSequence>
      <RemoveExistingProducts After="InstallInitialize"/>
    </InstallExecuteSequence>

    <Property Id="MajorMinorVersion">$(env.NOOBDAWN_VERSION)</Property>

    <Property Id="REINSTALLMODE" Value="amus"/> 

    <Upgrade Id="D320753C-4B18-4905-A752-E68959943E7D">
      <UpgradeVersion Minimum="0.18.0"
        IncludeMinimum="yes"
        IncludeMaximum="yes"
        Maximum="$(env.NOOBDAWN_VERSION).0"
        Property="OLDERVERSIONBEINGUPGRADED" />
      <UpgradeVersion OnlyDetect="yes" Property="NEWERVERSIONDETECTED" Minimum="$(env.NOOBDAWN_VERSION).0" IncludeMinimum="no" />
    </Upgrade>

    <Condition Message="A later version of [ProductName] is already installed">
      NOT NEWERVERSIONDETECTED
    </Condition>

    <Media Id='1' Cabinet='noobdawn.cab' EmbedCab='yes' CompressionLevel='high' DiskPrompt="CD-ROM #1" />
    <Property Id='DiskPrompt' Value="NoobDawn Installation [1]" />

    <Directory Id='TARGETDIR' Name='SourceDir'>
      <Directory Id='ProgramFiles64Folder' Name='PFiles'>
        <Directory Id='INSTALLDIR' Name='NoobDawn'>

          <Component Id='QNoobDawn' Win64="yes" Guid='44398F0D-3FE3-470A-A137-BDFDFE82353D'>
            <File Id='qnoobdawnEXE' Name='qnoobdawn.exe' DiskId='1' Source='dist/Release64/qnoobdawn.exe' KeyPath='yes'>
              <Shortcut Id="startmenuNoobDawn" Directory="ProgramMenuDir" Name="NoobDawn" WorkingDirectory='INSTALLDIR' Icon="icon.ico" IconIndex="0" Advertise="yes" />
            </File>

            <RegistryValue Root="HKLM" Id="VerbNBD" Action="write"
              Key="Software\Classes\NoobDawn.NBDCapture.1\shell\open\command"
              Value='"[#qnoobdawnEXE]" "%1"'
              Type="expandable" />
            <RegistryValue Root="HKLM" Id="VerbDescNBD" Action="write"
              Key="Software\Classes\NoobDawn.NBDCapture.1"
              Value='NoobDawn Capture Log (.nbd)'
              Type="expandable" />
            <RegistryValue Root="HKLM" Id="VerbIconNBD" Action="write"
              Key="Software\Classes\NoobDawn.NBDCapture.1\DefaultIcon"
              Value='[#qnoobdawnEXE]'
              Type="expandable" />
            <RegistryValue Root="HKLM" Id="NBDProgIDCLSID" Action="write"
              Key="Software\Classes\NoobDawn.NBDCapture.1\CLSID"
              Value='{5D6BF029-A6BA-417A-8523-120492B1DCE3}'
              Type="expandable" />

            <RegistryValue Root="HKLM" Id="VerbCAP" Action="write"
              Key="Software\Classes\NoobDawn.NBDSettings.1\shell\open\command"
              Value='"[#qnoobdawnEXE]" "%1"'
              Type="expandable" />
            <RegistryValue Root="HKLM" Id="VerbDescCAP" Action="write"
              Key="Software\Classes\NoobDawn.NBDSettings.1"
              Value='NoobDawn Capture Settings (.cap)'
              Type="expandable" />
            <RegistryValue Root="HKLM" Id="VerbIconCAP" Action="write"
              Key="Software\Classes\NoobDawn.NBDSettings.1\DefaultIcon"
              Value='[#qnoobdawnEXE]'
              Type="expandable" />

          </Component>

          <Component Id='NoobDawnCPP' Win64="yes" Guid='9D5949F9-0447-47B6-829D-77465E1FDAD9'>
            <File Id='NoobDawnCPP' Name='noobdawn.dll' DiskId='1' Source='dist/Release64/noobdawn.dll' KeyPath='yes' />
            <File Id='NoobDawnJSON' Name='noobdawn.json' DiskId='1' Source='dist/Release64/noobdawn.json' />
            <File Id='D3DCompiler47DLL64' Name='d3dcompiler_47.dll' DiskId='1' Source='dist/Release64/d3dcompiler_47.dll' />
            <File Id='NoobDawnSHIM' Name='noobdawnshim64.dll' DiskId='1' Source='dist/Release64/noobdawnshim64.dll' />
            <File Id='dbghelpDLL' Name='dbghelp.dll' DiskId='1' Source='dist/Release64/dbghelp.dll' />
            <File Id='symsrvDLL' Name='symsrv.dll' DiskId='1' Source='dist/Release64/symsrv.dll' />
            <File Id='symsrvYES' Name='symsrv.yes' DiskId='1' Source='dist/Release64/symsrv.yes' />

            <File Id='NoobDawnAPIheader' Name='noobdawn_app.h' DiskId='1' Source='dist/Release64/noobdawn_app.h' />

            <RegistryValue Root="HKLM" Id="NBDCLSID" Action="write"
              Key="Software\Classes\CLSID\{5D6BF029-A6BA-417A-8523-120492B1DCE3}"
              Value='NoobDawn Thumbnail Handler'
              Type="expandable" />
            <RegistryValue Root="HKLM" Id="NBDCLSIDServer" Action="write"
              Key="Software\Classes\CLSID\{5D6BF029-A6BA-417A-8523-120492B1DCE3}\InprocServer32"
              Value='[#NoobDawnCPP]'
              Type="expandable" />

            <RegistryValue Root="HKLM" Id="NBDVulkanImplicitLayer" Action="write"
              Key="Software\Khronos\Vulkan\ImplicitLayers"
              Name='[#NoobDawnJSON]'
              Value='0'
              Type="integer" />
          </Component>

